# Copiá este archivo a .env (nunca lo subas al repositorio) o cargá estas
# variables en Vercel → Project → Settings → Environment Variables.

# Base de datos libSQL/Turso. En local puede ser un archivo:
#   DATABASE_URL=file:./data/criptico.db
DATABASE_URL=
# Token de Turso (solo para bases remotas: turso db tokens create <db>)
DATABASE_AUTH_TOKEN=

# URL pública del sitio, sin barra final (se usa en sitemap, canónicas y enlaces)
SITE_URL=https://tu-dominio.com
SITE_NAME="Play Crípticos"

# Sal secreta para el hash de IPs (antiabuso). Generá una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Secreto que Vercel Cron envía como "Authorization: Bearer ..." a /api/cron/tick
CRON_SECRET=

# Opcionales
# NODE_ENV=production
# AUTO_MIGRATE=0            # migrar al arrancar (por defecto: sí en desarrollo, no en producción)
# INTERNAL_SCHEDULER=1      # temporizador interno, solo para servidores propios (no Vercel)
# EDITORIAL_NAME=Equipo editorial
# Credenciales de fuentes externas: una variable por fuente, con el nombre que
# indiques en el panel (campo "Credencial"), por ejemplo:
# SOURCE_EJEMPLO_TOKEN=

# Google AdSense (opcional, ver docs/MONETIZACION.md). Sin ADSENSE_CLIENT no se carga nada de anuncios.
# Los anuncios recién salen cuando se publican la privacidad y las cookies que los explican.
ADSENSE_CLIENT=
# Bloque de anuncios manual (opcional): si falta, solo funcionan los anuncios automáticos.
ADSENSE_SLOT=

# Plan Plus con PayPal (opcional, ver docs/PLUS.md). Sin estas claves el botón de pago queda deshabilitado.
# PAYPAL_ENV=sandbox para pruebas; por defecto live.
PAYPAL_ENV=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Planes de suscripción de PayPal (P-…): mensual USD 1,50 y anual
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
# Webhook de https://playcripticos.com/api/billing/webhook (para verificar la firma de PayPal)
PAYPAL_WEBHOOK_ID=
